# Loaded automatically by Vite for `npm run dev` only (not `npm run build`).
# Local development runs the frontend and backend as two separate dev
# servers on two different ports, so API calls need an absolute URL here —
# unlike the single-container production build, which defaults to a
# relative path since it's served by the backend itself (see api.ts).
VITE_API_BASE_URL=http://localhost:8000
