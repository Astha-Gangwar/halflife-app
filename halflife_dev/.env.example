# Copy this file to .env (gitignored) and fill in your own values.
# Loaded automatically by backend/main.py's load_dotenv() call.

# Your GCP project id -- used for both Firestore and (if enabled below) Vertex AI.
GOOGLE_CLOUD_PROJECT=

# TRUE = the ADK agent authenticates to Gemini via Vertex AI using Application
# Default Credentials (gcloud auth application-default login locally, or the
# Cloud Run service's own service account in production) -- no API key needed.
# FALSE (or unset) falls back to the public Gemini Developer API, which needs
# GOOGLE_API_KEY set instead.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Region for Vertex AI calls -- pick one close to your Firestore database's
# own region to cut cross-region latency on every agent tool-calling round trip.
GOOGLE_CLOUD_LOCATION=

# Only needed if GOOGLE_GENAI_USE_VERTEXAI is FALSE.
# GOOGLE_API_KEY=
