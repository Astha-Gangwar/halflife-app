rules_version = '2';

// The FastAPI backend is the only reader/writer of Firestore: it talks to
// Firestore server-side via the `google-cloud-firestore` client, authenticated
// with the Cloud Run service's Application Default Credentials (which bypass
// these rules entirely, same as the Admin SDK). No browser or mobile client
// ever talks to Firestore directly in this architecture, so client access is
// simply denied outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
